<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Payment Upload</title>
    <style>
        body { font-family: Arial, sans-serif; max-width: 500px; margin: 50px auto; padding: 20px; background: #f5f5f5; }
        .container { background: white; padding: 30px; border-radius: 10px; box-shadow: 0 0 10px rgba(0,0,0,0.1); }
        h2 { text-align: center; color: #333; }
        label { display: block; margin: 10px 0 5px; font-weight: bold; }
        input { width: 100%; padding: 8px; border: 1px solid #ddd; border-radius: 5px; }
        button { width: 100%; padding: 10px; background: #ffc107; color: #333; border: none; border-radius: 5px; margin-top: 15px; cursor: pointer; }
        button:hover { background: #e0a800; }
        .error { color: red; margin: 10px 0; padding: 10px; background: #ffebee; border-radius: 5px; }
        .success { color: green; margin: 10px 0; padding: 10px; background: #e8f5e9; border-radius: 5px; }
        .nav { text-align: center; margin-top: 15px; }
        .nav a { margin: 0 10px; color: #007bff; text-decoration: none; }
        .info { background: #e3f2fd; padding: 15px; border-radius: 5px; margin: 10px 0; }
        .info h4 { margin: 0 0 10px 0; }
    </style>
</head>
<body>
    <div class="container">
        <h2>Tuition Payment Upload</h2>
        
        <div class="info">
            <h4>Payment Instructions (R9):</h4>
            <p>Please use Mobile Banking to transfer payment to CST College bank account.</p>
        </div>
        
        <% if (error) { %>
            <div class="error"><%= error %></div>
        <% } %>
        <% if (success) { %>
            <div class="success"><%= success %></div>
        <% } %>
        
        <form action="/payment" method="POST">
            <label for="screenshotFile">Payment Screenshot (R10):</label>
            <input type="text" id="screenshotFile" name="screenshotFile" placeholder="Enter filename (e.g., receipt.jpg)" required>
            <small>Allowed: JPG, JPEG, PNG only</small>
            
            <label for="transactionNumber">Transaction Number (R11):</label>
            <input type="text" id="transactionNumber" name="transactionNumber" placeholder="Format: 123-456789012" required>
            <small>Format: 3 digits - hyphen - 9 digits</small>
            
            <button type="submit">Upload Payment</button>
        </form>
        
        <div class="nav">
            <a href="/">Login</a> |
            <a href="/register">Register</a> |
            <a href="/results">Results</a>
        </div>
    </div>
</body>
</html>